# Local changes on top of configs/common/linux-mainline/defconfig, merged with scripts/kconfig/merge_config.sh.

# Needed by the Milk-V Duo 256M and the LicheeRV Nano (SG2002); the base config only has the SG2000 pin controller.
CONFIG_PINCTRL_SOPHGO_SG2002=y

# No debug info: it makes the build slow and adds a 400MB -dbg package for nothing.
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
