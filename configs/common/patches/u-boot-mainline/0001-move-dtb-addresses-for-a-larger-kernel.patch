From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kiritake Kumi <root@niconiconi.us>
Date: Tue, 20 Oct 2026 10:29:21 +0800
Subject: [PATCH] u-boot: move the DTB, overlay, pxe and script addresses up
 for a larger kernel

The distroboot environment loads the kernel at 0x80200000 and the device tree at
0x81200000, which leaves 16MB for the kernel image. A mainline kernel with the
drivers of this project is larger than that (about 22MB), so it would overwrite
the device tree. Leave 34MB, the same layout Armbian uses for these boards.
Only applied when building the mainline kernel variant.

diff --git a/include/configs/cv181x-asic.h b/include/configs/cv181x-asic.h
index 9ea3cbac..bb77eaec 100644
--- a/include/configs/cv181x-asic.h
+++ b/include/configs/cv181x-asic.h
@@ -288,10 +288,10 @@
 		"sdboot=" SD_BOOTM_COMMAND "\0" \
 		"othbootargs=" OTHERBOOTARGS "\0" \
 		"kernel_addr_r=" __stringify(CONFIG_SYS_TEXT_BASE) "\0" \
-		"fdt_addr_r=0x81200000\0" \
-		"fdtoverlay_addr_r=0x81300000\0" \
-		"pxefile_addr_r=0x81400000\0" \
-		"scriptaddr=0x81500000\0" \
+		"fdt_addr_r=0x82200000\0" \
+		"fdtoverlay_addr_r=0x82300000\0" \
+		"pxefile_addr_r=0x82400000\0" \
+		"scriptaddr=0x82500000\0" \
 		"ramdisk_addr_r=0x84000000\0" \
 		"kernel_comp_addr_r=" __stringify(CVIMMAP_UIMAG_ADDR) "\0" \
 		"kernel_comp_size=" __stringify(CVIMMAP_UIMAG_SIZE) "\0" \
-- 
